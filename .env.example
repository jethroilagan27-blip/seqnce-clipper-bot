# Copy to .env (repo root) and fill in. Never commit .env.

# --- Storage (default: ./storage) ---
# STORAGE_DIR=

# --- FFmpeg (default: ./tools/ffmpeg, then PATH) ---
# FFMPEG_PATH=
# FFPROBE_PATH=

# --- Limits ---
MAX_UPLOAD_MB=500
MAX_VIDEO_DURATION_S=1800
# Finished jobs (video, renders, temp files) older than this are deleted at startup; 0 = keep forever
RETENTION_DAYS=7

# --- CORS (comma-separated origins allowed to call the API) ---
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# --- AI (needed from Day 3) ---
# Free key: https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash
WHISPER_MODEL=small
WHISPER_DEVICE=cpu
WHISPER_COMPUTE_TYPE=int8
# Leave empty to auto-detect the spoken language (e.g. en, tl)
WHISPER_LANGUAGE=
FRAME_INTERVAL_S=3
FRAME_WIDTH=512
# Max images sent to the AI per call (free-tier budget guard)
MAX_AI_FRAMES=12
SCENE_THRESHOLD=0.35
AI_MAX_RETRIES=3
