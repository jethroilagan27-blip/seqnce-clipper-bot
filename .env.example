# Copy to .env (repo root) and fill in. Never commit .env.

# --- Storage (default: ./storage) ---
# STORAGE_DIR=

# --- FFmpeg (default: ./tools/ffmpeg, then PATH) ---
# FFMPEG_PATH=
# FFPROBE_PATH=

# With accounts on, each person saves their own Gemini key in Settings; it is stored encrypted. Leave this empty to let the
# server make its own secret (storage/.ai_key_secret: keep it with the database), or set a long random value.
AI_KEY_SECRET=
# true = every account uses the GEMINI_API_KEY above (your quota); nobody needs a key of their own
SHARE_SERVER_AI_KEY=false

# --- Limits ---
MAX_UPLOAD_MB=500
# Leave this at 0 (or out) on your own computer: files go up in one request. Set it to the biggest request a proxy in
# front of the server allows (Cloudflare's free plan: 100) and the website sends bigger files in pieces of at most 50 MB.
PROXY_REQUEST_LIMIT_MB=0
MAX_VIDEO_DURATION_S=1800
# Finished jobs (video, renders, temp files) older than this are deleted at startup; 0 = keep forever
RETENTION_DAYS=7

# --- CORS (comma-separated origins allowed to call the API) ---
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# --- AI (needed from Day 3) ---
# Free key: https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Optional second key. Used ONLY for a request the key above refuses because it has reached its usage limit; the next
# request tries the first key again. A key from a project with billing switched on makes a good backup.
GEMINI_API_KEY_BACKUP=
GEMINI_MODEL=gemini-3.5-flash
WHISPER_MODEL=small
WHISPER_DEVICE=cpu
WHISPER_COMPUTE_TYPE=int8
# Leave empty to auto-detect the spoken language (e.g. en, tl)
WHISPER_LANGUAGE=
FRAME_INTERVAL_S=3
FRAME_WIDTH=512
# Max images sent to the AI per call (free-tier budget guard)
MAX_AI_FRAMES=12
SCENE_THRESHOLD=0.35
AI_MAX_RETRIES=3

# --- Accounts (leave off for local use; turn on before sharing the server) ---
# true = invite-only accounts, every user only sees their own videos, daily limits apply.
AUTH_ENABLED=false
# Signs the short-lived media tokens. Leave empty: a random one is created once in storage/.auth_secret.
AUTH_SECRET=
SESSION_DAYS=14
# Per user, rolling 24 hours (admins are unlimited; override per user with `python -m app.admin set-limits`)
DAILY_VIDEO_LIMIT=3
DAILY_CHAT_LIMIT=20
# Videos one user may have queued/processing at once (keeps a shared queue fair)
MAX_ACTIVE_JOBS_PER_USER=1
# false = invite-only (python -m app.admin invite). true = anyone can create an account with just an email
# and a password; no email check, so keep the caps below low.
OPEN_SIGNUP=false
# open sign-up only: most new accounts per rolling 24 h on the whole server, and per visitor per hour
SIGNUP_DAILY_CAP=50
SIGNUP_PER_IP_PER_HOUR=5
